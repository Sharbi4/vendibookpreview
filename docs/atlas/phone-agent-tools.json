      "method": "POST",
      "request_headers": {
        "x-vendibook-tool-secret": {
          "secret": "PHONE_AGENT_TOOL_SECRET"
        }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
