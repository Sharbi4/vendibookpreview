    "response_timeout_secs": 20,
    "api_schema": {
      "url": "https://nbrehbwfsmedbelzntqs.supabase.co/functions/v1/phone-support-tools?tool=message_seller",
      "method": "POST",
      "request_headers": {
        "x-vendibook-tool-secret": {
          "secret": "PHONE_AGENT_TOOL_SECRET"
        }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "listing_id": {
            "type": "string",
            "description": "listing_id from search_listings."
          },
          "message": {
            "type": "string",
            "description": "The exact message the caller approved."
          },
          "name": {
            "type": "string",
            "description": "Caller's first and last name."
          },
          "email": {
            "type": "string",
            "description": "Caller's email, spelled back."
          },
          "caller_confirmed_exact_message": {
            "type": "boolean",
            "description": "True only after reading the exact message back and the caller said to send it."
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id",
            "description": "The number the caller is calling from."
          },
          "conversation_id": {
            "type": "string",
            "dynamic_variable": "system__conversation_id",
            "description": "This call's conversation id."
          }
        },
        "required": [
          "listing_id",
          "message",
          "caller_confirmed_exact_message",
          "conversation_id"
        ]
      }
    }
  },
  {
    "type": "webhook",
    "name": "start_listing_draft",
    "description": "Start a free listing draft from the call. Verified callers get it on their account; others get a private finish link. Never publishes.",
    "response_timeout_secs": 20,
    "api_schema": {
      "url": "https://nbrehbwfsmedbelzntqs.supabase.co/functions/v1/phone-support-tools?tool=start_listing_draft",
      "method": "POST",
      "request_headers": {
        "x-vendibook-tool-secret": {
          "secret": "PHONE_AGENT_TOOL_SECRET"
        }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "food_truck",
              "food_trailer",
              "ghost_kitchen",
              "vendor_lot",
              "vendor_space"
            ],
            "description": "What they're looking for or listing. ghost_kitchen = shared or commercial kitchen."
          },
          "mode": {
            "type": "string",
            "enum": [
              "rent",
              "sale"
            ]
          },
          "title": {
            "type": "string",
            "description": "Short title, e.g. '2019 Ford 18 ft food truck with full kitchen'."
          },
          "city": {
            "type": "string",
            "description": "City."
          },
          "state": {
            "type": "string",
            "description": "State, e.g. TX."
          },
          "description": {
            "type": "string",
            "description": "What the caller said about it, in plain sentences. No phone numbers or emails."
          },
          "price_daily": {
            "type": "number",
            "description": "Rental daily price."
          },
          "price_weekly": {
            "type": "number",
            "description": "Rental weekly price."
          },
          "price_monthly": {
            "type": "number",
            "description": "Rental monthly price."
          },
          "deposit_amount": {
            "type": "number",
            "description": "Rental security deposit."
          },
          "price_sale": {
            "type": "number",
            "description": "Sale price."
          },
          "condition": {
            "type": "string",
            "enum": [
              "new",
              "like_new",
              "good",
              "fair",
              "needs_work"
            ],
            "description": "Condition the seller states."
          },
          "equipment": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Key equipment, e.g. 'fryer', 'flat-top griddle', 'hood with fire suppression'."
          },
          "conversation_id": {
            "type": "string",
            "dynamic_variable": "system__conversation_id",
            "description": "This call's conversation id."
          }
        },
        "required": [
          "category",
          "mode",
          "title",
          "city",
          "state",
          "conversation_id"
        ]
      }
    }
  },
