        "x-vendibook-tool-secret": {
          "secret": "PHONE_AGENT_TOOL_SECRET"
        }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "listing_id": {
            "type": "string",
            "description": "listing_id from search_listings."
          }
        },
        "required": [
          "listing_id"
        ]
      }
    }
  },
  {
    "type": "webhook",
    "name": "send_listing_links",
    "description": "Text (to the calling number, after the text disclosure and a yes) or email the caller links to listings, or to the free listing page.",
    "response_timeout_secs": 20,
    "api_schema": {
      "url": "https://nbrehbwfsmedbelzntqs.supabase.co/functions/v1/phone-support-tools?tool=send_listing_links",
      "method": "POST",
      "request_headers": {
        "x-vendibook-tool-secret": {
          "secret": "PHONE_AGENT_TOOL_SECRET"
        }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "listing_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 5 listing_ids from search_listings."
          },
          "method": {
            "type": "string",
            "enum": [
              "text",
              "email"
            ]
          },
          "email": {
            "type": "string",
            "description": "Their email, spelled back, for email links."
          },
          "text_consent": {
            "type": "boolean",
            "description": "True only after reading the text disclosure and the caller said yes."
          },
          "include_listing_start": {
            "type": "boolean",
            "description": "Also include the link to list equipment for free."
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id",
            "description": "The number the caller is calling from."
          },
          "conversation_id": {
            "type": "string",
            "dynamic_variable": "system__conversation_id",
            "description": "This call's conversation id."
          }
        },
        "required": [
          "method",
          "conversation_id"
        ]
      }
    }
  },
  {
    "type": "webhook",
    "name": "message_seller",
