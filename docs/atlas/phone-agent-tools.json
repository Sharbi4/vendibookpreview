  {
    "type": "webhook",
    "name": "search_listings",
    "description": "Search live Vendibook listings (the same search as the website). Returns up to 5 with listing_id, title, price and city.",
    "response_timeout_secs": 25,
    "api_schema": {
      "url": "https://nbrehbwfsmedbelzntqs.supabase.co/functions/v1/phone-support-tools?tool=search_listings",
      "method": "POST",
      "request_headers": {
        "x-vendibook-tool-secret": {
          "secret": "PHONE_AGENT_TOOL_SECRET"
        }
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free-text keywords, e.g. 'taco truck' or 'trailer with hood'."
          },
          "category": {
            "type": "string",
            "enum": [
              "food_truck",
              "food_trailer",
              "ghost_kitchen",
              "vendor_lot",
              "vendor_space"
            ],
            "description": "What they're looking for or listing. ghost_kitchen = shared or commercial kitchen."
          },
          "mode": {
            "type": "string",
            "enum": [
              "rent",
              "sale"
            ],
            "description": "Rent or buy."
          },
          "location": {
            "type": "string",
            "description": "City and state or ZIP, e.g. 'Houston, TX'."
          },
          "max_price": {
            "type": "number",
            "description": "Budget: daily rate for rentals, sale price for purchases."
          },
          "instant_book_only": {
            "type": "boolean",
            "description": "Only rentals they can book instantly."
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "webhook",
    "name": "get_listing",
    "description": "Details of one live listing from search_listings: price, deposit, location, condition, size, equipment and description.",
    "response_timeout_secs": 20,
    "api_schema": {
      "url": "https://nbrehbwfsmedbelzntqs.supabase.co/functions/v1/phone-support-tools?tool=get_listing",
