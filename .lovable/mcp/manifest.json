{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nbrehbwfsmedbelzntqs.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "vendibook-mcp",
      "version": "0.1.0",
      "title": "Vendibook"
    },
    "tools": [
      {
        "name": "search_listings",
        "title": "Search Vendibook listings",
        "description": "Search published Vendibook marketplace listings (food trucks, trailers, shared kitchens, vendor lots) by keyword, city, or transaction type. Returns public listing summaries only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Free-text search across title and description."
            },
            "city": {
              "type": "string",
              "description": "Filter by city name."
            },
            "transaction_type": {
              "type": "string",
              "enum": [
                "rent",
                "sale",
                "any"
              ],
              "description": "Filter by rent, sale, or any."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "description": "Max results, default 10."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_listing",
        "title": "Get a Vendibook listing",
        "description": "Fetch the full public detail for a single published Vendibook listing by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "listing_id": {
              "type": "string",
              "format": "uuid",
              "description": "The listing UUID."
            }
          },
          "required": [
            "listing_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_listings",
        "title": "List my Vendibook listings",
        "description": "List all listings owned by the signed-in Vendibook user (drafts, published, and archived).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "published",
                "archived",
                "any"
              ],
              "description": "Filter by status, default any."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_bookings",
        "title": "List my Vendibook bookings",
        "description": "List bookings made by the signed-in Vendibook user, most recent first. Respects Vendibook's per-user access rules.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "shopper",
                "host",
                "any"
              ],
              "description": "Filter by whether you are the shopper (renter/buyer) or the host. Default any."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
